# Fase 0 — contoh env (TANPA nilai rahasia). Copy ke .env.local lalu isi.
# Primer = Postgres + Redis LOKAL yang sudah jalan di host.

# --- Postgres lokal (primer, sesuai temuan: 127.0.0.1:5432/agent_dev, PG 18.6) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=agent
POSTGRES_PASSWORD=isi-di-env-local-saja
POSTGRES_DB=agent_dev
POSTGRES_URL_NON_POOLING=postgresql://agent:isi-di-env-local-saja@127.0.0.1:5432/agent_dev
DATABASE_URL=postgresql://agent:isi-di-env-local-saja@127.0.0.1:5432/agent_dev

# --- Docker compose opsional (port alternatif, tidak tabrakan dengan native) ---
DOCKER_POSTGRES_PORT=5433
DOCKER_REDIS_PORT=6380
DOCKER_POSTGRES_URL=postgresql://agent:isi-di-env-local-saja@127.0.0.1:5433/agent_dev

# --- Redis lokal (primer) ---
REDIS_URL=redis://127.0.0.1:6379

# --- API (apps/api) ---
API_PORT=3001
JWT_SECRET=isi-di-env-local-min-32-karakter
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_DEFAULT_LOCALE=id
